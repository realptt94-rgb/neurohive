# ============================================
# NEUROHIVE BACKEND CONFIGURATION
# ============================================

# Server
PORT=3001
NODE_ENV=production

# CORS - URL du frontend
FRONTEND_URL=https://votre-domaine.netlify.app

# GPU Monitoring
# Si vous avez des GPUs NVIDIA, le backend détectera automatiquement
# Sinon, il utilisera des données simulées
NVIDIA_SMI_PATH=/usr/bin/nvidia-smi

# WebSocket
WS_HEARTBEAT_INTERVAL=30000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ============================================
# OPTIONNEL - APIs Externes
# ============================================

# Prometheus (pour métriques avancées)
# PROMETHEUS_URL=http://localhost:9090

# Grafana (pour visualisation)
# GRAFANA_URL=http://localhost:3000

# NVIDIA GPU Cloud (pour modèles pré-entraînés)
# NGC_API_KEY=your_key_here

# Hugging Face (pour NEURONS, DNRT)
# HF_TOKEN=your_token_here

# OpenAI (pour LLM reasoning)
# OPENAI_API_KEY=your_key_here

# ============================================
# DATABASE (Optionnel - pour persistance)
# ============================================

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/neurohive

# Redis (pour cache)
# REDIS_URL=redis://localhost:6379

# MongoDB (pour logs)
# MONGODB_URL=mongodb://localhost:27017/neurohive
